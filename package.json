{
  "name": "pehchan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "capture": "node scripts/capture-demo.mjs",
    "capture:fresh": "pnpm build && node scripts/capture-demo.mjs",
    "start": "next start",
    "prepare": "lefthook install",
    "arch": "eslint --config eslint.arch.mjs src --max-warnings=0",
    "prove": "bash scripts/prove-guardrails.sh",
    "harness": "bash scripts/harness-score.sh",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.98",
    "@ai-sdk/react": "4.0.150",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "ai": "7.0.146",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "lefthook": "^2.2.2",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.9.1"
}
